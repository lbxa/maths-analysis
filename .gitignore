# Generated build directories at any depth.
build/

# Local lecture images and converted copies.
/images/

# Compiled documents at any depth; retain source figures.
*.pdf
*.dvi
*.xdv
*.ps
!/figures/**/*.pdf
!/figures/**/*.ps

# LaTeX, bibliography, index, and glossary output at any depth.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lol
*.lot
*.loa
*.loe
*.out
*.run.xml
*.toc
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.glsdefs
*.nlg
*.nlo
*.nls
*.nav
*.snm
*.vrb
*.brf
*.thm
*.tdo
*.spl

# Compiler recovery files and editor-generated auxiliary metadata.
*-SAVE-ERROR
*.auxlock
*.pdfsync
*.aux.bak
*.bbl.bak
*.bcf.bak
*.run.xml.bak

# SyncTeX output, including files written during compilation.
*.synctex
*.synctex.gz
*.synctex(busy)
*.synctex.gz(busy)

# macOS metadata.
.DS_Store
